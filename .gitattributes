# Artifacts are byte-compared with what Maximo returns (extract -> re-extract must be
# identical). MAS emits LF, so pin LF regardless of core.autocrlf.
src/**        text eol=lf
bootstrap/**  text eol=lf
*.py          text eol=lf
*.js          text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.rptdesign   text eol=lf
