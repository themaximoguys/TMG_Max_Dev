# Copy to environments/.env.<name>  (e.g. .env.dev). Real .env files are git-ignored.
#
# MAXIMO_BASE_URL  Manage URL including /maximo
#                  MAS 9:  https://<workspace>.manage.<domain>/maximo
# MAXIMO_API_KEY   API key for a least-privilege integration user (Administration > API Keys).
#                  MAS 9 /maximo/oslc is OIDC-only; this tool uses /maximo/api + apikey header.
# MAXIMO_MAXAUTH   base64(user:password) — only for non-MAS / native-auth 7.6 sources.
# MAXIMO_PROTECTED true blocks every write from this tool (use for TEST/PROD read-only access).
# MAXIMO_VERIFY_TLS false only for lab clusters with self-signed certs.
#
# Per-environment object-structure overrides, if a tenant names a structure differently:
#   MAXIMO_OS_DOMAIN=MXDOMAIN          (key = artifact type id, upper-case)

MAXIMO_BASE_URL=https://dev.manage.example.com/maximo
MAXIMO_API_KEY=
MAXIMO_PROTECTED=false
MAXIMO_VERIFY_TLS=true

# IBM Maximo MCP server (MAS 9.2+, partial feature set). Used by `maxdev ibm-mcp` and the
# ibm_mcp_* tools. For Claude Code's direct connection (.mcp.json) export the same two
# variables in your shell before starting claude.
# MAXIMO_MCP_URL=https://<instance>-mcp.<domain>/mcp
# MAXIMO_MCP_AUTH=apikey          # or bearer + MAXIMO_MCP_TOKEN=<jwt>
