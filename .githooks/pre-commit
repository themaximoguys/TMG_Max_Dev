#!/bin/sh
# Offline gate: shared agent wiring, developed components, script standards, whitespace.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
PY=${PYTHON:-python3}
git diff --cached --check
"$PY" tools/check_agent_setup.py
"$PY" tools/check_components.py
scripts=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.py' 'src/*.js')
if [ -n "$scripts" ]; then
    # shellcheck disable=SC2086
    "$PY" -m maxdev lint $scripts
fi
if git diff --cached --name-only | grep -qE '^(maxdev|tests|tools)/'; then
    "$PY" -m unittest discover -s tests -q
fi
